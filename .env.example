# ==============================================================================
# Opportunity Radar — Environment Variables
# Copy this file to .env.local and configure your secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Required for zero-hallucination AI structured extraction)
# Obtain a key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Notion Integration (Required for saving approved opportunities to Notion)
# Create an integration at: https://www.notion.so/my-integrations
# Make sure to invite/share your Notion database with the integration!
# ------------------------------------------------------------------------------
NOTION_API_KEY=ntn_your_notion_secret_token_here
NOTION_DATABASE_ID=your_32_character_database_id_here

# ------------------------------------------------------------------------------
# 3. Optional Port / Host
# ------------------------------------------------------------------------------
PORT=3000

